<?xml version="1.0" encoding="utf-8"?>
<!-- Appui long sur l'icône : ouvre directement une fiche. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="collectes"
        android:shortcutShortLabel="@string/shortcut_collection">
        <intent
            android:action="es.antonborri.home_widget.action.LAUNCH"
            android:data="aujourdhui://detail/collection"
            android:targetClass="ca.saguenayaujourdhui.saguenay_aujourdhui.MainActivity"
            android:targetPackage="ca.saguenayaujourdhui.saguenay_aujourdhui" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="meteo"
        android:shortcutShortLabel="@string/shortcut_weather">
        <intent
            android:action="es.antonborri.home_widget.action.LAUNCH"
            android:data="aujourdhui://detail/weather"
            android:targetClass="ca.saguenayaujourdhui.saguenay_aujourdhui.MainActivity"
            android:targetPackage="ca.saguenayaujourdhui.saguenay_aujourdhui" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="urgences"
        android:shortcutShortLabel="@string/shortcut_emergency">
        <intent
            android:action="es.antonborri.home_widget.action.LAUNCH"
            android:data="aujourdhui://detail/emergency"
            android:targetClass="ca.saguenayaujourdhui.saguenay_aujourdhui.MainActivity"
            android:targetPackage="ca.saguenayaujourdhui.saguenay_aujourdhui" />
    </shortcut>
</shortcuts>
